{
  "name": "githb-ranking",
  "version": "0.1.1",
  "description": "查看每天 GitHub 仓库排名与 DSH 插件排名，打开仓库看详情与趋势，并订阅关注仓库/作者的变化",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "scripts",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "liuhao11223",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuhao11223/githb-ranking"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-0 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check-workbench-package.mjs",
    "pack:check": "pnpm pack --dry-run",
    "test": "node --test tests/*.test.mjs"
  }
}